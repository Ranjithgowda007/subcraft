{
  "name": "subcraft",
  "version": "0.1.0",
  "description": "Zero-dependency isomorphic TypeScript subtitle engine for parsing, retiming, and locale-aware quality linting (powered by Intl.Segmenter).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "subtitle",
    "srt",
    "vtt",
    "webvtt",
    "parser",
    "linter",
    "intl-segmenter",
    "kannada",
    "indic",
    "grapheme",
    "timecode",
    "resync"
  ],
  "author": "Ranjith Gowda <ranjithg0507@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
