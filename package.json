{
  "name": "subcraft",
  "version": "0.2.0",
  "description": "Zero-dependency isomorphic TypeScript subtitle engine for parsing, retiming, WebVTT/SRT conversion, and Unicode grapheme-cluster quality linting (powered by Intl.Segmenter).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ranjithgowda007/subcraft.git"
  },
  "bugs": {
    "url": "https://github.com/Ranjithgowda007/subcraft/issues"
  },
  "homepage": "https://github.com/Ranjithgowda007/subcraft#readme",
  "keywords": [
    "subtitle",
    "srt",
    "vtt",
    "webvtt",
    "parser",
    "linter",
    "intl-segmenter",
    "grapheme",
    "kannada",
    "indic",
    "timecode",
    "resync",
    "retime"
  ],
  "author": "Ranjith Gowda <ranjithg0507@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "fast-check": "^3.23.2",
    "publint": "^0.3.8",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
